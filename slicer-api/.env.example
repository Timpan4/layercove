# Sidecar image references must be immutable digests. Tags and `latest` are rejected by deployment review.
ORCA_SIDECAR_IMAGE=ghcr.io/your-org/orca-slicer-api@sha256:REPLACE_WITH_VERIFIED_DIGEST
BAMBU_SIDECAR_IMAGE=ghcr.io/your-org/bambu-studio-api@sha256:REPLACE_WITH_VERIFIED_DIGEST

# Optional host ports are intentionally not published by compose. To expose a
# sidecar, add an explicit ports override and put authenticated TLS in front.
