+def _resliced_print_name(name: str) -> str:
+    """Reserve the suffix inside the archive column's character limit."""
+    suffix = " (re-sliced)"
+    limit = PrintArchive.__table__.c.print_name.type.length
+    return name[: limit - len(suffix)] + suffix
