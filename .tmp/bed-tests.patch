+describe('serialized cloud bed geometry', () => {
+  const area = ['-50x-20', '250x-20', '250x280', '-50x280'];
+  it.each([
+    area.join(','),
+    JSON.stringify(area),
+    [area.join(',')],
+  ].map((printable_area) => ({ printable_area })))('reads the same bed from cloud-serialized coordinates: %j', ({ printable_area }) => {
